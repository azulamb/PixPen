<Window x:Class="PixPen.Views.Dialogs.TabletSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ペンタブの設定"
        Width="380" Height="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="入力 API" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <CheckBox Grid.Row="1" Grid.ColumnSpan="2"
                  Content="Wacom WinTab API を使用する（要 Wacom ドライバ/アプリ再起動）"
                  IsChecked="{Binding UseWinTab}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="筆圧カーブ" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Text="最小筆圧" VerticalAlignment="Center"/>
        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="0.9"
                Value="{Binding PressureCurve.MinPressure}" Margin="4"/>

        <TextBlock Grid.Row="4" Text="最大筆圧" VerticalAlignment="Center"/>
        <Slider Grid.Row="4" Grid.Column="1" Minimum="0.1" Maximum="1"
                Value="{Binding PressureCurve.MaxPressure}" Margin="4"/>

        <TextBlock Grid.Row="5" Text="ガンマ" VerticalAlignment="Center"/>
        <Slider Grid.Row="5" Grid.Column="1" Minimum="0.2" Maximum="5"
                Value="{Binding PressureCurve.Gamma}" Margin="4" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="72" Margin="4" Click="OnOk"/>
            <Button Content="キャンセル" Width="72" Margin="4" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
