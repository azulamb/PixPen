<Window x:Class="PixPen.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixPen について"
        Width="360" Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="PixPen" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="シンプルなお絵かきツール" FontSize="13"
                   HorizontalAlignment="Center" Margin="0,4,0,12"/>
        <Separator/>
        <TextBlock Text="WPF (.NET 10)" HorizontalAlignment="Center" Margin="0,8"/>
        <Button Content="閉じる" Width="80" Margin="0,12,0,0"
                HorizontalAlignment="Center" Click="OnClose"/>
    </StackPanel>
</Window>
