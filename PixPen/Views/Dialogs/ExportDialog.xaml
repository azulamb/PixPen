<Window x:Class="PixPen.Views.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="エクスポート"
        Width="340" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="エクスポート形式" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <RadioButton x:Name="RadioMerged" Content="全レイヤーを合成して1枚の PNG として保存"
                         IsChecked="True" Margin="0,4"/>
            <RadioButton x:Name="RadioLayers" Content="可視レイヤーを個別 PNG としてフォルダに保存"
                         Margin="0,4"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="エクスポート" Width="90" Margin="4" Click="OnExport"/>
            <Button Content="キャンセル" Width="72" Margin="4" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
