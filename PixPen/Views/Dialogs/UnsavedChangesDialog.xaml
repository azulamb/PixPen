<Window x:Class="PixPen.Views.Dialogs.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="未保存の変更"
        Width="360" Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="保存されていない変更があります。&#x0a;終了しますか？"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="13"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="保存せず終了"
                    Width="110" Height="28" Margin="0,0,8,0"
                    Click="OnExitWithoutSave"/>
            <Button Content="戻る"
                    Width="80" Height="28"
                    IsDefault="False"
                    IsCancel="True"
                    Click="OnReturn"/>
        </StackPanel>
    </Grid>
</Window>
