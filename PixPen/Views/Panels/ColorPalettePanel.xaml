<UserControl x:Class="PixPen.Views.Panels.ColorPalettePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左：カラー一覧（スウォッチ26px + 余白4px + スクロールバー約17px） -->
            <ColumnDefinition Width="52" MinWidth="46"/>
            <ColumnDefinition Width="4"/>
            <!-- 右：編集エリア -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ─── カラー一覧（左・縦並び） ─────────────────────────────── -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="1">
                <Button Content="＋" Width="14" Height="14" FontSize="8" Padding="0"
                        Command="{Binding ColorPanel.AddColorCommand}"
                        ToolTip="現在の色をパレットに追加"/>
                <Button Content="－" Width="14" Height="14" FontSize="8" Padding="0"
                        Command="{Binding ColorPanel.RemoveColorCommand}"
                        ToolTip="末尾の色を削除"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding ColorPanel.PaletteColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26" Height="26" Margin="2,1"
                                    Padding="0" BorderThickness="1"
                                    Command="{Binding DataContext.ColorPanel.SelectColorCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding}">
                                <Button.Background>
                                    <SolidColorBrush Color="{Binding}"/>
                                </Button.Background>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#FF555555" ResizeBehavior="PreviousAndNext"/>

        <!-- ─── 編集エリア（右） ───────────────────────────────────────── -->
        <Grid Grid.Column="2" Margin="4,4,2,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>  <!-- カラープレビュー -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <!-- カラープレビュー -->
            <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       Margin="0,0,0,4" RadiusX="2" RadiusY="2"
                       Stroke="#FF888888" StrokeThickness="1">
                <Rectangle.Fill>
                    <SolidColorBrush Color="{Binding ColorPanel.Foreground}"/>
                </Rectangle.Fill>
            </Rectangle>

            <!-- H -->
            <TextBlock Grid.Row="1" Text="H" VerticalAlignment="Center" FontSize="10"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="360"
                    Value="{Binding ColorPanel.Hue}" Margin="2,1" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="2" FontSize="10" Margin="2,1"
                     Text="{Binding ColorPanel.Hue, StringFormat=F0, UpdateSourceTrigger=LostFocus}"/>

            <!-- S -->
            <TextBlock Grid.Row="2" Text="S" VerticalAlignment="Center" FontSize="10"/>
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1"
                    Value="{Binding ColorPanel.Saturation}" Margin="2,1" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="2" FontSize="10" Margin="2,1"
                     Text="{Binding ColorPanel.Saturation, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>

            <!-- V -->
            <TextBlock Grid.Row="3" Text="V" VerticalAlignment="Center" FontSize="10"/>
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1"
                    Value="{Binding ColorPanel.Brightness}" Margin="2,1" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="2" FontSize="10" Margin="2,1"
                     Text="{Binding ColorPanel.Brightness, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>

            <!-- A -->
            <TextBlock Grid.Row="4" Text="A" VerticalAlignment="Center" FontSize="10"/>
            <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255"
                    Value="{Binding ColorPanel.Alpha}" Margin="2,1" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="2" FontSize="10" Margin="2,1"
                     Text="{Binding ColorPanel.Alpha, UpdateSourceTrigger=LostFocus}"/>
        </Grid>
    </Grid>
</UserControl>
