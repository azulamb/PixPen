<UserControl x:Class="PixPen.Views.Panels.ColorPalettePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" MinWidth="46"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ─── カラー一覧（左・縦並び） ─────────────────────────────── -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="1">
                <Button Content="＋" Width="14" Height="14" FontSize="8" Padding="0"
                        Command="{Binding ColorPanel.AddColorCommand}"
                        ToolTip="現在の色をパレットに追加"/>
                <Button Content="－" Width="14" Height="14" FontSize="8" Padding="0"
                        Command="{Binding ColorPanel.RemoveColorCommand}"
                        ToolTip="末尾の色を削除"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding ColorPanel.PaletteColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26" Height="26" Margin="2,1"
                                    Padding="0" BorderThickness="1"
                                    Command="{Binding DataContext.ColorPanel.SelectColorCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding}">
                                <Button.Background>
                                    <SolidColorBrush Color="{Binding}"/>
                                </Button.Background>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#FF555555" ResizeBehavior="PreviousAndNext"/>

        <!-- ─── 編集エリア（右） ───────────────────────────────────────── -->
        <DockPanel Grid.Column="2" Margin="2">

            <!-- カラープレビュー（常に表示） -->
            <Rectangle DockPanel.Dock="Top" Height="26" Margin="2,2,2,2"
                       RadiusX="2" RadiusY="2"
                       Stroke="#FF888888" StrokeThickness="1">
                <Rectangle.Fill>
                    <SolidColorBrush Color="{Binding ColorPanel.Foreground}"/>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 指定方法タブ -->
            <TabControl>

                <!-- ─── RGB（デフォルト） ─── -->
                <TabItem Header="RGB">
                    <Grid Margin="2,4,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="R" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.R}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.R, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.G}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.G, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.B}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.B, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="3" Text="A" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.Alpha}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Alpha, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </TabItem>

                <!-- ─── HSV ─── -->
                <TabItem Header="HSV">
                    <Grid Margin="2,4,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="H" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="360"
                                Value="{Binding ColorPanel.Hue}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Hue, StringFormat=F0, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="1" Text="S" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1"
                                Value="{Binding ColorPanel.Saturation}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Saturation, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="2" Text="V" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1"
                                Value="{Binding ColorPanel.Brightness}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Brightness, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="3" Text="A" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.Alpha}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Alpha, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </TabItem>

            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
