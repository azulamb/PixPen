<UserControl x:Class="PixPen.Views.Panels.ColorPalettePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <!-- スウォッチボタン: ホバー時は白枠を太く、クリック時は黒枠（背景色は変えない） -->
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF888888"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="outerBorder"
                                BorderBrush="#FF888888" BorderThickness="1"
                                CornerRadius="1" SnapsToDevicePixels="True">
                            <Border x:Name="innerBorder"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Background="{TemplateBinding Background}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ホバー: 外枠を白・2px に変更 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerBorder" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="outerBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <!-- 押下: 外枠を黒に変更 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="outerBorder" Property="BorderBrush" Value="#FF111111"/>
                                <Setter TargetName="outerBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" MinWidth="46"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ─── カラー一覧（左） ──────────────────────────────────────── -->
        <DockPanel Grid.Column="0">

            <!-- 追加・削除ボタン（下部・横幅いっぱい） -->
            <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="1,2,1,1">
                <Button Command="{Binding ColorPanel.AddColorCommand}"
                        ToolTip="現在の色をパレットに追加"
                        Height="22" Padding="2">
                    <iconPacks:PackIconMaterial Kind="Plus" Width="12" Height="12"/>
                </Button>
                <Button Command="{Binding ColorPanel.RemoveColorCommand}"
                        ToolTip="末尾の色を削除"
                        Height="22" Padding="2">
                    <iconPacks:PackIconMaterial Kind="Minus" Width="12" Height="12"/>
                </Button>
            </UniformGrid>

            <!-- スウォッチ一覧 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding ColorPanel.PaletteColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Grid でボタンと選択インジケーターを重ねる -->
                            <Grid Width="26" Height="26" Margin="2,1">
                                <Button Style="{StaticResource SwatchButtonStyle}"
                                        Command="{Binding DataContext.ColorPanel.SelectColorCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding}">
                                    <Button.Background>
                                        <SolidColorBrush Color="{Binding}"/>
                                    </Button.Background>
                                </Button>

                                <!-- 選択中インジケーター：アクセントカラーの内枠 -->
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource App.Accent}"
                                        BorderThickness="2"
                                        CornerRadius="1">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource ColorMatchConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.ColorPanel.Foreground"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Border.Visibility>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#FF555555" ResizeBehavior="PreviousAndNext"/>

        <!-- ─── 編集エリア（右） ──────────────────────────────────────── -->
        <DockPanel Grid.Column="2" Margin="2">

            <!-- プリセット管理（上部） -->
            <Border DockPanel.Dock="Top" Margin="2,2,2,4">
                <StackPanel>
                    <!-- プリセット名 / 選択 ComboBox -->
                    <ComboBox IsEditable="True"
                              Text="{Binding ColorPanel.PresetName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding ColorPanel.PresetNames}"
                              FontSize="9" Height="20" Margin="0,0,0,2"
                              ToolTip="プリセット名を入力または選択"/>
                    <!-- 読込 / 保存 / 削除 / デフォルト設定 -->
                    <UniformGrid Rows="1">
                        <Button Command="{Binding ColorPanel.LoadPresetCommand}"
                                ToolTip="選択したプリセットを読み込む"
                                Height="22" Padding="2">
                            <iconPacks:PackIconMaterial Kind="FolderOpen" Width="12" Height="12"/>
                        </Button>
                        <Button Command="{Binding ColorPanel.SavePresetCommand}"
                                ToolTip="現在のパレットをプリセットとして保存（基本パレットは保存不可）"
                                Height="22" Padding="2">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Width="12" Height="12"/>
                        </Button>
                        <Button Command="{Binding ColorPanel.DeletePresetCommand}"
                                ToolTip="選択したプリセットを削除"
                                Height="22" Padding="2">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="12" Height="12"/>
                        </Button>
                        <!-- デフォルト設定：現在デフォルトなら塗りつぶし星、そうでなければ空星 -->
                        <Button Command="{Binding ColorPanel.SetAsDefaultCommand}"
                                ToolTip="このプリセットを起動時のデフォルトパレットに設定する"
                                Height="22" Padding="2">
                            <iconPacks:PackIconMaterial Width="12" Height="12">
                                <iconPacks:PackIconMaterial.Style>
                                    <Style TargetType="iconPacks:PackIconMaterial">
                                        <Setter Property="Kind" Value="StarOutline"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ColorPanel.IsCurrentDefault}" Value="True">
                                                <Setter Property="Kind" Value="Star"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconMaterial.Style>
                            </iconPacks:PackIconMaterial>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- カラープレビュー（左:不透明 / 右:アルファ有効＋市松模様） -->
            <Border DockPanel.Dock="Top" Height="26" Margin="2,0,2,4"
                    BorderBrush="#FF888888" BorderThickness="1"
                    CornerRadius="2" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：アルファ無視・不透明 -->
                    <Rectangle Grid.Column="0">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{Binding ColorPanel.OpaqueColor}"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- 右：市松模様（透過の視覚化） -->
                    <Rectangle Grid.Column="1">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile"
                                          Viewport="0,0,8,8"
                                          ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#FFB0B0B0">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,8,8"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FF808080">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,4,4"/>
                                                    <RectangleGeometry Rect="4,4,4,4"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 右：アルファ有効で色を重ねる -->
                    <Rectangle Grid.Column="1">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{Binding ColorPanel.Foreground}"/>
                        </Rectangle.Fill>
                    </Rectangle>

                </Grid>
            </Border>

            <!-- 指定方法タブ -->
            <TabControl>

                <!-- ─── RGB ─── -->
                <TabItem Header="RGB">
                    <Grid Margin="2,4,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="R" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.R}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.R, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.G}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.G, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.B}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.B, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="3" Text="A" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.Alpha}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Alpha, UpdateSourceTrigger=LostFocus}"/>

                        <!-- HEX カラーコード（AARRGGBB形式、スライダーと双方向連動） -->
                        <TextBlock Grid.Row="4" Text="#" VerticalAlignment="Center" FontSize="10"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                 FontSize="10" Margin="2,3,2,1"
                                 FontFamily="Consolas, Courier New, monospace"
                                 CharacterCasing="Upper"
                                 MaxLength="8"
                                 ToolTip="カラーコード（AARRGGBB）。6 桁で入力すると A は現在値を維持します。"
                                 Text="{Binding ColorPanel.HexCode,
                                     UpdateSourceTrigger=PropertyChanged,
                                     Mode=TwoWay}"/>
                    </Grid>
                </TabItem>

                <!-- ─── HSV ─── -->
                <TabItem Header="HSV">
                    <Grid Margin="2,4,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="H" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="360"
                                Value="{Binding ColorPanel.Hue}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Hue, StringFormat=F0, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="1" Text="S" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1"
                                Value="{Binding ColorPanel.Saturation}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Saturation, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="2" Text="V" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1"
                                Value="{Binding ColorPanel.Brightness}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Brightness, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="3" Text="A" VerticalAlignment="Center" FontSize="10"/>
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255"
                                Value="{Binding ColorPanel.Alpha}" Margin="2,1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="2" FontSize="10" Margin="2,1"
                                 Text="{Binding ColorPanel.Alpha, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </TabItem>

            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
