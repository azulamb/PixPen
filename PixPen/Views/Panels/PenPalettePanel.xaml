<UserControl x:Class="PixPen.Views.Panels.PenPalettePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:PixPen.Models"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" MinWidth="50"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ─── ペン一覧（左） ─────────────────────────────────────────── -->
        <DockPanel Grid.Column="0">
            <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="1,2,1,1">
                <Button Command="{Binding PenPanel.AddPenCommand}"
                        ToolTip="ペンを追加" Height="22" Padding="2">
                    <iconPacks:PackIconMaterial Kind="Plus" Width="12" Height="12"/>
                </Button>
                <Button Command="{Binding PenPanel.DeletePenCommand}"
                        ToolTip="ペンを削除" Height="22" Padding="2">
                    <iconPacks:PackIconMaterial Kind="Minus" Width="12" Height="12"/>
                </Button>
            </UniformGrid>
            <ListBox ItemsSource="{Binding PenPanel.Pens}"
                     SelectedItem="{Binding PenPanel.SelectedPen}"
                     DisplayMemberPath="Name"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#FF555555" ResizeBehavior="PreviousAndNext"/>

        <!-- ─── 設定エリア（右） ─────────────────────────────────────── -->
        <Grid Grid.Column="2" Margin="4,4,2,4"
              IsEnabled="{Binding PenPanel.HasSelection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="名前" VerticalAlignment="Center" FontSize="10"/>
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,2"
                     FontSize="10"
                     Text="{Binding PenPanel.SelectedPen.Name, UpdateSourceTrigger=LostFocus}"/>

            <TextBlock Grid.Row="1" Text="形状" VerticalAlignment="Center" FontSize="10"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,2"
                      FontSize="10"
                      SelectedItem="{Binding PenPanel.SelectedPen.Shape}"
                      ItemsSource="{x:Static m:PenShapeValues.All}"/>

            <TextBlock Grid.Row="2" Text="サイズ" VerticalAlignment="Center" FontSize="10"/>
            <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="200"
                    Value="{Binding PenPanel.SelectedPen.Size}"
                    Margin="2,2" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="2" Margin="2,2" FontSize="10"
                     Text="{Binding PenPanel.SelectedPen.Size, StringFormat=F1,
                            UpdateSourceTrigger=LostFocus}"/>

            <TextBlock Grid.Row="3" Text="不透明度" VerticalAlignment="Center" FontSize="10"/>
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1"
                    Value="{Binding PenPanel.SelectedPen.Opacity}"
                    Margin="2,2" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="2" Margin="2,2" FontSize="10"
                     Text="{Binding PenPanel.SelectedPen.Opacity, StringFormat=F2,
                            UpdateSourceTrigger=LostFocus}"/>

            <TextBlock Grid.Row="4" Text="最小倍率" VerticalAlignment="Center" FontSize="10"/>
            <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1"
                    Value="{Binding PenPanel.SelectedPen.MinSizeFactor}"
                    Margin="2,2" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="2" Margin="2,2" FontSize="10"
                     Text="{Binding PenPanel.SelectedPen.MinSizeFactor, StringFormat=F2,
                            UpdateSourceTrigger=LostFocus}"/>

            <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                      Content="筆圧でサイズを変える" FontSize="10" Margin="0,4,0,0"
                      IsChecked="{Binding PenPanel.SelectedPen.PressureAffectsSize}"/>
        </Grid>
    </Grid>
</UserControl>
