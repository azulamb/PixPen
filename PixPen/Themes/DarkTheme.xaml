<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════
         アプリ固有カラーリソース（App.*）
         ════════════════════════════════════════════════════════ -->

    <!-- 基本 -->
    <SolidColorBrush x:Key="App.Bg"                     Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="App.Panel.Bg"               Color="#FF252526"/>
    <SolidColorBrush x:Key="App.Ctrl.Bg"                Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="App.Fg"                     Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="App.Subtle.Fg"              Color="#FF9D9D9D"/>
    <SolidColorBrush x:Key="App.Border"                 Color="#FF555555"/>
    <SolidColorBrush x:Key="App.Hover"                  Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="App.Pressed"                Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="App.Accent"                 Color="#FF0078D7"/>

    <!-- 選択 -->
    <SolidColorBrush x:Key="App.Selected.Bg"            Color="#FF0078D7"/>
    <SolidColorBrush x:Key="App.Selected.Fg"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="App.Selected.Inactive.Bg"   Color="#FF37373D"/>
    <SolidColorBrush x:Key="App.Selected.Inactive.Fg"   Color="#FFD4D4D4"/>

    <!-- 無効 -->
    <SolidColorBrush x:Key="App.Disabled.Fg"            Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="App.Disabled.Bg"            Color="#FF2D2D30"/>

    <!-- メニュー / ツールバー -->
    <SolidColorBrush x:Key="App.Menu.Bg"                Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="App.Menu.Hover"             Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="App.Menu.Separator"         Color="#FF444444"/>
    <SolidColorBrush x:Key="App.Toolbar.Bg"             Color="#FF2D2D30"/>

    <!-- タブ -->
    <SolidColorBrush x:Key="App.Tab.Active.Bg"          Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="App.Tab.Inactive.Bg"        Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="App.Tab.Active.Fg"          Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="App.Tab.Inactive.Fg"        Color="#FF9D9D9D"/>
    <SolidColorBrush x:Key="App.Tab.Border"             Color="#FF555555"/>

    <!-- スプリッター -->
    <SolidColorBrush x:Key="App.Splitter"               Color="#FF555555"/>

    <!-- ポップアップ -->
    <SolidColorBrush x:Key="App.Popup.Bg"               Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="App.Popup.Border"           Color="#FF555555"/>

    <!-- フロートウィンドウ固有 -->
    <SolidColorBrush x:Key="App.FloatBar.Bg"            Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="App.FloatBar.Fg"            Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="App.FloatBtn.Bg"            Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="App.FloatBtn.Fg"            Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="App.FloatBtn.Border"        Color="#FF666666"/>

    <!-- スクロールバー -->
    <SolidColorBrush x:Key="App.Scrollbar.Track"        Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="App.Scrollbar.Thumb"        Color="#FF555555"/>
    <SolidColorBrush x:Key="App.Scrollbar.Thumb.Hover"  Color="#FF888888"/>

    <!-- ════════════════════════════════════════════════════════
         SystemColors オーバーライド（WPF 標準コントロールのテーマ対応）
         ════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"                          Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"                      Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"                         Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"                     Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}"                    Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}"                     Color="#FF555555"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}"                 Color="#FF444444"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                       Color="#FF0078D7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"      Color="#FF37373D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"  Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"                            Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"                         Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"                        Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}"                   Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"                        Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}"                            Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}"                        Color="#FFD4D4D4"/>

</ResourceDictionary>
