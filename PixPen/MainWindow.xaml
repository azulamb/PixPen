<Window x:Class="PixPen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PixPen.ViewModels"
        xmlns:ctrl="clr-namespace:PixPen.Controls"
        xmlns:tools="clr-namespace:PixPen.Tools"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="PixPen"
        Height="720" Width="1280"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnFileDrop"
        DragEnter="OnDragEnter"
        DragOver="OnDragEnter">

    <!-- キーボードショートカット -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewDocumentCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="W"      Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="X"      Modifiers="Ctrl" Command="{Binding CutCommand}"/>
        <KeyBinding Key="C"      Modifiers="Ctrl" Command="{Binding CopyCommand}"/>
        <KeyBinding Key="V"      Modifiers="Ctrl" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="Delete"               Command="{Binding DeleteCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- ─── メニュー ─────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規作成(_N)" Command="{Binding NewDocumentCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="開く(_O)..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="名前をつけて保存(_A)..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="エクスポート(_E)..." Command="{Binding ExportCommand}"/>
                <Separator/>
                <MenuItem Header="ドキュメントの設定(_D)..." Command="{Binding DocumentSettingsCommand}"/>
                <MenuItem Header="設定(_P)..." Command="{Binding AppSettingsCommand}"/>
                <MenuItem Header="ペンタブの設定(_T)..." Command="{Binding TabletSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="タブを閉じる(_W)" Command="{Binding CloseTabCommand}" InputGestureText="Ctrl+W"/>
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_U)" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="やり直す(_R)" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="切り取り(_X)" Command="{Binding CutCommand}"    InputGestureText="Ctrl+X"/>
                <MenuItem Header="コピー(_C)"   Command="{Binding CopyCommand}"   InputGestureText="Ctrl+C"/>
                <MenuItem Header="貼り付け(_V)" Command="{Binding PasteCommand}"  InputGestureText="Ctrl+V"/>
                <MenuItem Header="削除(_D)"     Command="{Binding DeleteCommand}" InputGestureText="Delete"/>
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="グリッド(_G)" Command="{Binding ToggleGridCommand}"
                          IsCheckable="True" IsChecked="{Binding IsGridVisible}"/>
                <MenuItem Header="グリッドの設定..." Command="{Binding GridSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="UI レイアウトの設定(_L)..." Command="{Binding UILayoutCommand}"/>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="PixPen について..." Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ─── ツールバー ───────────────────────────────────── -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <!-- Undo/Redo/Save -->
                <Button Command="{Binding UndoCommand}" ToolTip="元に戻す (Ctrl+Z)" Width="34" Height="34" Padding="6">
                    <iconPacks:PackIconMaterial Kind="UndoVariant"/>
                </Button>
                <Button Command="{Binding RedoCommand}" ToolTip="やり直す (Ctrl+Y)" Width="34" Height="34" Padding="6">
                    <iconPacks:PackIconMaterial Kind="RedoVariant"/>
                </Button>
                <Button Command="{Binding SaveCommand}" ToolTip="保存 (Ctrl+S)" Width="34" Height="34" Padding="6">
                    <iconPacks:PackIconMaterial Kind="ContentSave"/>
                </Button>
                <Separator/>
                <!-- グリッド -->
                <ToggleButton IsChecked="{Binding IsGridVisible}" ToolTip="グリッド" Width="34" Height="34" Padding="6">
                    <iconPacks:PackIconMaterial Kind="Grid"/>
                </ToggleButton>
                <Separator/>
                <!-- ツール選択 -->
                <RadioButton GroupName="Tool" IsChecked="{Binding IsToolFill}"
                             ToolTip="塗りつぶし (F)" Width="34" Height="34" Padding="6"
                             Style="{StaticResource ToolRadioStyle}">
                    <iconPacks:PackIconMaterial Kind="FormatColorFill"/>
                </RadioButton>
                <RadioButton GroupName="Tool" IsChecked="{Binding IsToolPen}"
                             ToolTip="ペン (P)" Width="34" Height="34" Padding="6"
                             Style="{StaticResource ToolRadioStyle}">
                    <iconPacks:PackIconMaterial Kind="Pencil"/>
                </RadioButton>
                <RadioButton GroupName="Tool" IsChecked="{Binding IsToolEyedropper}"
                             ToolTip="スポイト (I)" Width="34" Height="34" Padding="6"
                             Style="{StaticResource ToolRadioStyle}">
                    <iconPacks:PackIconMaterial Kind="Eyedropper"/>
                </RadioButton>
                <RadioButton GroupName="Tool" IsChecked="{Binding IsToolEraser}"
                             ToolTip="消しゴム (E)" Width="34" Height="34" Padding="6"
                             Style="{StaticResource ToolRadioStyle}">
                    <iconPacks:PackIconMaterial Kind="Eraser"/>
                </RadioButton>
                <RadioButton GroupName="Tool" IsChecked="{Binding IsToolSelection}"
                             ToolTip="範囲選択 (S)" Width="34" Height="34" Padding="6"
                             Style="{StaticResource ToolRadioStyle}">
                    <iconPacks:PackIconMaterial Kind="SelectionDrag"/>
                </RadioButton>
            </ToolBar>
        </ToolBarTray>

        <!-- ─── ステータスバー ─────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" Height="22">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ─── メインコンテンツ（5 列） ─────────────────────── -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <!-- 左サイドパネル（空のとき Width=0 で非表示） -->
                <ColumnDefinition x:Name="LeftSideCol"      Width="0"/>
                <ColumnDefinition x:Name="LeftSplitterCol"  Width="0"/>
                <!-- キャンバス -->
                <ColumnDefinition Width="*"/>
                <!-- 右サイドパネル -->
                <ColumnDefinition x:Name="RightSplitterCol" Width="4"/>
                <ColumnDefinition x:Name="RightSideCol"     Width="240" MinWidth="160" MaxWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- 左サイドパネル（コードビハインドで動的構築） -->
            <Grid x:Name="LeftSidePanelGrid"
                  Grid.Column="0"
                  IsEnabled="{Binding ActiveTab, Converter={StaticResource NullToBoolConverter}}"/>

            <!-- 左スプリッター -->
            <GridSplitter x:Name="LeftSplitter"
                          Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource App.Splitter}" ResizeBehavior="PreviousAndNext"
                          Visibility="Collapsed"/>

            <!-- キャンバスタブエリア -->
            <TabControl x:Name="CanvasTabControl"
                        Grid.Column="2"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding ActiveTab}"
                        TabStripPlacement="Top">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CanvasTabViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Content="✕" Width="16" Height="16" Margin="4,0,0,0"
                                    FontSize="9" Padding="0"
                                    Command="{Binding DataContext.CloseTabCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" BorderBrush="Transparent"
                                    Style="{x:Null}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:CanvasTabViewModel}">
                        <ctrl:DrawingCanvas DataContext="{Binding}"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- 右スプリッター -->
            <GridSplitter x:Name="RightSplitter"
                          Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource App.Splitter}" ResizeBehavior="PreviousAndNext"/>

            <!-- 右サイドパネル（コードビハインドで動的構築） -->
            <Grid x:Name="RightSidePanelGrid"
                  Grid.Column="4"
                  IsEnabled="{Binding ActiveTab, Converter={StaticResource NullToBoolConverter}}"/>
        </Grid>
    </DockPanel>
</Window>
